{
  "map": "maps/marshgate-route",
  "max_t": 320,
  "expect": [
    "SURVIVOR_CONFIRMED",
    "CHAIN_POSITION",
    "chain_formed",
    "REPLAN",
    "chain_ready",
    "MISSION_COMPLETE",
    "summary"
  ],
  "steps": [
    {
      "after": "chain_formed",
      "wait": 8,
      "do": "click",
      "mode": "debris",
      "x": 5.8,
      "y": 24.8
    },
    {
      "after": "prev",
      "wait": 12,
      "do": "undo"
    },
    {
      "after": "chain_ready",
      "wait": 3,
      "do": "act2"
    },
    {
      "after": "prev",
      "wait": 0.5,
      "do": "ff_autopilot"
    },
    {
      "after": "prev",
      "wait": 15,
      "do": "click",
      "mode": "debris",
      "ahead_of_ff": 5
    },
    {
      "after": "prev",
      "wait": 8,
      "do": "undo"
    },
    {
      "after": "MISSION_COMPLETE",
      "wait": 3,
      "do": "stop"
    }
  ]
}
